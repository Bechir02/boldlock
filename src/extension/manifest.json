{
  "manifest_version": 3,
  "name": "BoldLock - LinkedIn Post Formatter",
  "version": "1.0.0",
  "description": "Format LinkedIn posts with bold, italic, code fonts, bullet points, and check hook cutoff fold directly in your browser.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "BoldLock Formatter",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "clipboardWrite",
    "storage"
  ]
}
